option_settings:
  aws:elasticbeanstalk:application:environment:
    HEALTHCHECK_PATH: /health.php

files:
  "/health.php":
    mode: "000644"
    owner: root
    group: root
    content: |
      <?php
      http_response_code(200);
      header('Content-Type: application/json');
      echo json_encode(['ok' => true, 'time' => date('c')]);
