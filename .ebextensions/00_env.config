option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: 'false'
    DB_HOST: RDS_ENDPOINT_HERE
    DB_PORT: '3306'
    DB_NAME: natcondash1
    DB_USER: dbuser
    DB_PASS: supersecret
    PDF_DEFAULT_FONT: Helvetica
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /
    display_errors: 'Off'
    memory_limit: 256M
    max_execution_time: 60
    upload_max_filesize: 10M
    post_max_size: 12M
