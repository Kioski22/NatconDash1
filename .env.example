# Copy to .env for local development. Do NOT commit real secrets.
APP_ENV=local
APP_DEBUG=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=natcondash1
DB_USER=root
DB_PASS=

# Mail (PHPMailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_pass
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Natcon Dashboard"

# PDF / Rendering
PDF_DEFAULT_FONT=Helvetica

# Session / Security
SESSION_SECURE=false
